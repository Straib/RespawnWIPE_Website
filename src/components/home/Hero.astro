---
import WipeButton from "../shared/WipeButton.astro";
import { squadService } from "../../services/wls_server_stats.service";

const server = await squadService.getServerStatus();
---

<section class="hero">
	<div class="wrap hero-inner">
		<div class="hero-copy">
			<span class="eyebrow">[SYS-READY] // TAKTISCHE SQUAD-COMMUNITY</span
			>
			<h1>NACH JEDEM <em>WIPE.</em><br />EIN RESPAWN.</h1>
			<p>
				Willkommen bei Respawn [WIPE], dem taktischen Squad-Verbund von
				We Love Squad (WLS). Koordinierte Gefechte, verlässliche
				Squadleiter und eine Community, die zusammenhält — auf jedem
				Wipe folgt ein neuer Respawn.
			</p>
			<div class="hero-actions">
				<WipeButton
					text="DISCORD BEITRETEN"
					href="https://discord.gg/H86PmQbc8z"
					style="primary"
					icon="bi:discord"
					size="lg"
				/>
				<WipeButton
					text="MEHR ÜBER UNS & REKRUTIERUNG"
					href="/recruitment/"
					style="secondary"
					size="lg"
				/>
			</div>
		</div>
	</div>
	{
		server && (
			<div class="wrap">
				<div class="server-strip">
					<div class="server-info">
						<span class="server-tag">{server.name}</span>
						<div class="server-meta">
							<span>{server.name}</span>
							<span>{server.players} / {server.maxPlayers}</span>
							<span>{server.isOnline ? "Online" : "Offline"}</span>
						</div>
					</div>
					<WipeButton
						text="CONNECT VIA STEAM"
						style="primary"
						href="steam://rungameid/393380//+connect 178.63.27.87:7787"
						target="_blank"
						rel="noreferrer"
					/>
				</div>
			</div>
		)
	}
</section>

<style>
	.hero {
		background:
			radial-gradient(
				circle at 80% 0%,
				rgba(229, 169, 88, 0.12),
				transparent 45%
			),
			var(--surface);
		padding-top: 56px;
	}
	.hero-inner {
		padding-bottom: 40px;
	}
	.hero-copy {
		max-width: 720px;
	}
	.hero-copy h1 {
		font: 800 clamp(80px, 5.5vw, 62px) / 1.05 var(--font-display);
		letter-spacing: 0.02em;
		margin: 0 0 18px;
	}
	.hero-copy h1 em {
		color: var(--primary);
		font-style: normal;
	}
	.hero-copy p {
		color: var(--outline);
		font-size: 16px;
		line-height: 1.7;
		max-width: 620px;
		margin: 0 0 26px;
	}
	.hero-actions {
		display: flex;
		flex-direction: column;
		align-items: start;
		gap: 16px;
		flex-wrap: wrap;
	}
	.server-strip {
		background: var(--surface-container-low);
		border: 1px solid var(--outline-variant);
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 18px 24px;
		gap: 20px;
		margin-bottom: 24px;
	}
	.server-tag {
		display: block;
		font: 700 12px var(--font-mono);
		color: var(--primary);
		letter-spacing: 0.04em;
	}
	.server-meta {
		display: flex;
		gap: 18px;
		margin-top: 6px;
		font: 10px var(--font-mono);
		color: var(--outline);
	}
	.steam-cta {
		flex: none;
		background: var(--primary-container);
		color: var(--surface-container-lowest);
		font: 700 10px var(--font-mono);
		letter-spacing: 0.06em;
		padding: 13px 18px;
	}
	.steam-cta:hover {
		background: var(--primary);
	}

	@media (max-width: 640px) {
		.hero {
			padding-top: 32px;
		}
		.server-strip {
			flex-direction: column;
			align-items: flex-start;
		}
		.steam-cta {
			width: 100%;
			text-align: center;
		}
	}
</style>
