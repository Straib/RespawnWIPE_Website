---
const members = [
	{ rank: 'MANAGEMENT', callsign: 'XRazerx', role: 'Clan-Gründer', joined: 'seit 2026', status: 'OFFLINE', department: 'command' },
	{ rank: 'MANAGEMENT', callsign: 'Gorgram', role: 'Drill Sargent', joined: 'seit 2026', status: 'ONLINE', department: 'command' },
	{ rank: 'MANAGEMENT', callsign: 'Straib', role: 'Recruitment Officer / DEV', joined: 'seit 2026', status: 'IN GAME', department: 'command' },
	{ rank: 'MANAGEMENT', callsign: 'Komodo', role: 'Ist auch dabei', joined: 'seit 2026', status: 'AWAY', department: 'command' },
];
const filters = [
	{ label: 'ALLE', value: 'all' },
	{ label: 'COMMAND', value: 'command' },
	{ label: 'ARMOR', value: 'armor' },
	{ label: 'LOGISTIK', value: 'logistik' },
	{ label: 'INFANTERIE', value: 'infanterie' },
];
---

<section class="roster-table-section">
	<div class="wrap">
		<div class="section-head">
			<span class="eyebrow">02 // EINSATZKADER PREVIEW</span>
			<h2>BATAILLONS-ROSTER & <em>DIENSTAKTEN</em></h2>
			<p>Ein Überblick über das aktuelle Command und die dienstältesten Kernrollen.</p>
		</div>
		<div class="filter-row" id="roster-filter-group">
			{
				filters.map((filter, index) => (
					<button class:list={['filter-pill', { active: index === 0 }]} data-filter={filter.value}>
						{filter.label}
					</button>
				))
			}
		</div>
		<div class="roster-table">
			<div class="roster-row roster-head">
				<span>RANG</span>
				<span>CALLSIGN</span>
				<span>ROLLE</span>
				<span>DABEI SEIT</span>
				<span>STATUS</span>
			</div>
			{
				members.map((member) => (
					<div class="roster-row" data-department={member.department}>
						<span class="rank-pill">{member.rank}</span>
						<strong>{member.callsign}</strong>
						<span>{member.role}</span>
						<span>{member.joined}</span>
						<span class:list={['status', member.status.toLowerCase().replace(' ', '-')]}>
							<i /> {member.status}
						</span>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	const filterGroup = document.getElementById('roster-filter-group');
	const rows = document.querySelectorAll<HTMLElement>('.roster-table .roster-row:not(.roster-head)');
	filterGroup?.querySelectorAll<HTMLButtonElement>('.filter-pill').forEach((btn) => {
		btn.addEventListener('click', () => {
			filterGroup.querySelectorAll('.filter-pill').forEach((b) => b.classList.remove('active'));
			btn.classList.add('active');
			const filter = btn.dataset.filter;
			rows.forEach((row) => {
				row.style.display = filter === 'all' || row.dataset.department === filter ? '' : 'none';
			});
		});
	});
</script>

<style>
	.roster-table-section {
		padding: 64px 0;
		border-top: 1px solid var(--outline-variant);
	}
	.section-head {
		margin-bottom: 20px;
	}
	.section-head h2 {
		font: 700 clamp(28px, 3.2vw, 34px) / 1.15 var(--font-display);
		letter-spacing: 0.03em;
		margin: 12px 0 12px;
	}
	.section-head h2 em {
		color: var(--primary);
		font-style: normal;
	}
	.section-head p {
		color: var(--outline);
		font-size: 16px;
		line-height: 1.7;
		max-width: 620px;
		margin: 0;
	}
	.filter-row {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
		margin-bottom: 16px;
	}
	.filter-pill {
		background: var(--surface-container);
		border: 1px solid var(--outline-variant);
		color: var(--outline);
		font: 600 10px var(--font-mono);
		letter-spacing: 0.06em;
		padding: 10px 16px;
	}
	.filter-pill:hover {
		color: var(--on-surface);
	}
	.filter-pill.active {
		background: var(--primary-container);
		border-color: var(--primary-container);
		color: var(--surface-container-lowest);
	}
	.roster-table {
		background: var(--surface-container-low);
		border: 1px solid var(--outline-variant);
	}
	.roster-row {
		display: grid;
		grid-template-columns: 1fr 1fr 2fr 1fr 1fr;
		gap: 12px;
		align-items: center;
		padding: 16px 24px;
		border-bottom: 1px solid var(--outline-variant);
		font: 12px var(--font-mono);
		color: var(--outline);
	}
	.roster-row:last-child {
		border-bottom: 0;
	}
	.roster-head {
		font: 600 10px var(--font-mono);
		letter-spacing: 0.08em;
		color: var(--on-surface);
	}
	.rank-pill {
		width: fit-content;
		background: rgba(255, 198, 123, 0.12);
		color: var(--primary);
		font: 700 9px var(--font-mono);
		letter-spacing: 0.05em;
		padding: 5px 9px;
	}
	.roster-row strong {
		font: 600 14px var(--font-display);
		color: var(--on-surface);
		letter-spacing: 0.02em;
	}
	.status {
		display: flex;
		align-items: center;
		gap: 5px;
		color: var(--primary);
	}
	.status i {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--primary-container);
	}
	.status.in-raid {
		color: var(--tertiary);
	}
	.status.in-raid i {
		background: var(--tertiary-container);
	}
	.status.away {
		color: var(--outline);
	}
	.status.away i {
		background: var(--outline-variant);
	}

	@media (max-width: 640px) {
		.roster-table-section {
			padding: 44px 0;
		}
		.roster-row {
			grid-template-columns: 1fr 1fr;
			row-gap: 6px;
		}
		.roster-head {
			display: none;
		}
	}
</style>
