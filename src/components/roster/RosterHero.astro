---
import WipeButton from "../shared/WipeButton.astro";
import { Icon } from "astro-icon/components";
---

<section class="roster-hero">
	<div class="wrap hero-inner">
		<div class="hero-copy">
			<span class="eyebrow"><i class="pulse-dot"></i> SYS_LOG // PERS-OPS // TAC_BATTALION</span>
			<h1>ROSTER & <em>REKRUTIERUNG.</em></h1>
			<p class="hero-subtitle">Werde Teil einer schlagkräftigen Einheit</p>
			<p>
				Lerne die Struktur von Respawn [WIPE] kennen — von Command &
				Squad Leaders bis zur spezialisierten Infanterie. Wir suchen
				zuverlässige Kameraden, die Teamplay über alles stellen.
			</p>
			<div class="hero-actions">
				<WipeButton
					text="DISCORD BEITRETEN"
					href="https://discord.gg/H86PmQbc8z"
					style="primary"
					icon="bi:discord"
					size="lg"
				/>
				<WipeButton
					text="SERVER STATUS ANSEHEN"
					href="/server/"
					style="secondary"
					size="lg"
				/>
			</div>
		</div>
	</div>
	<div class="wrap">
		<div class="metrics-strip">
			<div class="metric">
				<span class="metric-label">AKTIVE TRUPPEN</span>
				<strong>29+</strong>
			</div>
			<div class="metric">
				<span class="metric-label">BEWERBUNGS-STATUS</span>
				<strong class="metric-status">
					<Icon name="bi:check-circle-fill" size={14} /> OFFEN
				</strong>
			</div>
			<div class="metric">
				<span class="metric-label">AKTIV-TAG</span>
				<strong class="metric-tertiary">JEDEN SONNTAG 15:00–21:00 UHR</strong>
			</div>
		</div>
	</div>
	<div class="wrap">
		<div class="doctrine-banner">
			<span class="eyebrow">[BATTALION DOCTRINE]</span>
			<p>
				Bei [WIPE] gewinnt Disziplin vor Einzelleistung. Ob an
				vorderster Front, in schwerer Panzerung oder im
				Helikopter-Cockpit: Dein Trupp zählt auf dich.
			</p>
		</div>
	</div>
</section>

<style>
	.roster-hero {
		background:
			radial-gradient(
				circle at 80% 0%,
				rgba(229, 169, 88, 0.12),
				transparent 45%
			),
			var(--surface);
		padding-top: 56px;
	}
	.hero-inner {
		padding-bottom: 40px;
	}
	.hero-copy {
		max-width: 720px;
	}
	.eyebrow {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.pulse-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--primary);
		box-shadow: 0 0 8px var(--primary);
	}
	.hero-copy h1 {
		font: 800 clamp(80px, 5.5vw, 62px) / 1.05 var(--font-display);
		letter-spacing: 0.02em;
		margin: 10px 0 4px;
	}
	.hero-copy h1 em {
		color: var(--primary);
		font-style: normal;
	}
	.hero-subtitle {
		font: 700 16px var(--font-display);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--primary);
		margin: 0 0 18px;
	}
	.hero-copy > p:not(.hero-subtitle) {
		color: var(--outline);
		font-size: 16px;
		line-height: 1.7;
		max-width: 620px;
		margin: 0 0 26px;
	}
	.hero-actions {
		display: flex;
		flex-direction: column;
		align-items: start;
		gap: 16px;
		flex-wrap: wrap;
	}
	.metrics-strip {
		background: var(--surface-container-low);
		border: 1px solid var(--outline-variant);
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 18px 24px;
		gap: 20px;
		margin-bottom: 24px;
	}
	.metric {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.metric-label {
		font: 700 10px var(--font-mono);
		letter-spacing: 0.06em;
		color: var(--outline);
	}
	.metric strong {
		font: 700 20px var(--font-display);
		letter-spacing: 0.02em;
		color: var(--on-surface);
	}
	.metric-status {
		display: flex;
		align-items: center;
		gap: 6px;
		color: var(--primary) !important;
	}
	.metric-tertiary {
		color: var(--tertiary) !important;
	}
	.doctrine-banner {
		background: var(--surface-container-low);
		border-left: 3px solid var(--primary-container);
		padding: 20px 24px;
		margin-bottom: 24px;
	}
	.doctrine-banner p {
		color: var(--on-surface);
		font-size: 16px;
		line-height: 1.7;
		max-width: 720px;
		margin: 6px 0 0;
	}

	@media (max-width: 900px) {
		.metrics-strip {
			flex-direction: column;
			align-items: flex-start;
			gap: 16px;
		}
	}
	@media (max-width: 640px) {
		.roster-hero {
			padding-top: 32px;
		}
	}
</style>
